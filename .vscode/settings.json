{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.autoClean.run": "onFailed",
  "latex-workshop.latex.clean.subfolder.enabled": true,
  "latex-workshop.latex.recipe.default": "latexmk (SBC)",

  "latex-workshop.latex.recipes": [
    { "name": "latexmk (SBC)", "tools": ["latexmk"] },
    { "name": "pdflatex -> bibtex -> pdflatex*2", "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"] }
  ],

  "latex-workshop.latex.tools": [
    {
      "name": "latexmk",
      "command": "/Library/TeX/texbin/latexmk",
      "args": ["-pdf", "-outdir=%OUTDIR%", "%DOC%"]
    },
    {
      "name": "pdflatex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": ["-synctex=1","-interaction=nonstopmode","-file-line-error","-output-directory=%OUTDIR%","%DOC%"]
    },
    {
      "name": "bibtex",
      "command": "/Library/TeX/texbin/bibtex",
      "args": ["%OUTDIR%/%DOCFILE%"]
    }
  ],

  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.synctex.afterBuild.enabled": true,

  "latex-workshop.latexindent.path": "latexindent",
  "latex-workshop.formatting.latex": "latexindent",
  "[latex]": {
    "editor.formatOnSave": true,
    "editor.wordWrap": "on",
    "editor.rulers": [100],
    "editor.tabSize": 2
  },

  "ltex.language": "pt-BR",
  "ltex.additionalRules.enablePickyRules": true,

  "cSpell.language": "en,pt-BR",

  "files.exclude": {
    "**/*.aux": true, "**/*.log": true, "**/*.out": true, "**/*.toc": true,
    "**/*.bbl": true, "**/*.blg": true, "**/*.fls": true,
    "**/*.fdb_latexmk": true, "**/*.synctex.gz": true
  },
  "search.exclude": { "build/": true, "**/*.bbl": true }
}
